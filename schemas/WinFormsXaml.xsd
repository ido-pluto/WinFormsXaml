    <xs:union memberTypes="TableLayoutSizeTypeLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="StyleValue">
    <xs:annotation>
      <xs:documentation>
        A named resource-style key, {StaticResource StyleKey}, or a one-way
        expression selecting a key. Controls with a native Style property use a
        dedicated schema type and select markup styles through ResourceStyle.
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="StaticResourceExpression DynamicExpression xs:string" />
  </xs:simpleType>

