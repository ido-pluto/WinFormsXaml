        </xs:attribute>
        <xs:attribute name="SelectedTabCornerRadius" type="AtLeastMinusOneIntegerValue" default="-1">
          <xs:annotation><xs:documentation>Selected-header radius. -1 inherits TabCornerRadius. Native tabs ignore the stored radius.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ForceNativeTabsChanged" type="xs:string" />
        <xs:attribute name="TabBackgroundChanged" type="xs:string" />
        <xs:attribute name="SelectedTabBackgroundChanged" type="xs:string" />
