  <!-- Resources and styles -->

  <xs:complexType name="ResourcesType">
    <xs:annotation>
      <xs:documentation>
        Local style and preset resources. Resource property elements may be
        attached to any runtime element; common built-in owners are declared
        below and application/registered owner names remain available through
        the lax property-element wildcard.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="Style" />
      <xs:element ref="Presets" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="StyleType">
    <xs:annotation>
      <xs:documentation>
        A Key declares a named style; an unkeyed TargetType declares an implicit
        style. BasedOn, when present, uses {StaticResource StyleKey}. Dynamic
        setter expressions are one-way sources.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="Setter" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="Key" type="xs:string" />
    <xs:attribute name="TargetType" type="xs:string">
      <xs:annotation><xs:documentation>A CLR type name or {x:Type TypeName}.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="BasedOn" type="StaticResourceExpression" />
    <xs:attribute name="Condition" type="BooleanValue">
      <xs:annotation><xs:documentation>One-way condition. Inactive styles contribute no setters; changes restore the previous style layer before active styles are reapplied.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="SetterType" mixed="true">
    <xs:annotation><xs:documentation>Sets one property from Value or leaf text. Binding expressions in styles support OneWay only.</xs:documentation></xs:annotation>
    <xs:attribute name="Property" type="xs:string" use="required" />
    <xs:attribute name="Value" type="xs:string" />
    <xs:attribute name="Condition" type="BooleanValue">
      <xs:annotation><xs:documentation>Optional one-way condition controlling this setter only.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="Style" type="StyleType" />
  <xs:element name="Setter" type="SetterType" />
  <xs:element name="Form.Resources" type="ResourcesType" />
  <xs:element name="Panel.Resources" type="ResourcesType" />
  <xs:element name="Grid.Resources" type="ResourcesType" />
