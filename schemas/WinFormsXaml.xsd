    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TextWrappingValue">
    <xs:union memberTypes="TextWrappingLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="StretchLiteral">
