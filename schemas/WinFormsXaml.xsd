  <xs:element name="TabPage.Resources" type="ResourcesType" />
  <xs:element name="ToolStripContainer.Resources" type="ResourcesType" />

  <!-- Reusable include documents and directives -->

  <xs:complexType name="IncludesType">
    <xs:annotation>
      <xs:documentation>
        Root type for a standalone reusable Includes document and directive
        type for inserting one with Source. Included content can contain local
        Includes.Resources, Presets, nested Includes directives, registered
        components, and ordinary visual elements. Source, SourceKind, and
        Assembly are static composition metadata rather than runtime binding
        targets. Condition may be a Boolean literal or one-way dynamic
        expression and gates the included visual and style contributions.
        SourceKind defaults to Registered. Assembly is an assembly
        name and is used only with EmbeddedResource. When SourceKind is omitted,
        an embedded:// or file:// Source prefix selects the corresponding kind;
        an explicitly conflicting kind is rejected at runtime.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
    </xs:sequence>
    <xs:attribute name="Source" type="StaticIncludeReference">
      <xs:annotation>
        <xs:documentation>
          Static registered include identifier, manifest-resource name, or file
          path. Markup expressions are not valid during composition.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="SourceKind" type="IncludeSourceKindLiteral" default="Registered" />
    <xs:attribute name="Assembly" type="StaticIncludeReference">
      <xs:annotation>
        <xs:documentation>
          Optional static assembly name for SourceKind=EmbeddedResource.
          Markup expressions are not valid during composition.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Condition" type="BooleanValue">
      <xs:annotation>
        <xs:documentation>
          Optional Boolean literal or one-way Binding, Function, or Preset
          expression. Dynamic conditions retain composed controls and update
          their visibility in place. Included resource styles participate only
          while the condition is true. Nested include conditions are combined.
          Preset declarations are always imported as catalogs.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="Includes" type="IncludesType">
    <xs:annotation>
      <xs:documentation>
        Standalone reusable markup root when Source is omitted; include
        directive when Source identifies registered, embedded, or file markup.
      </xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="IncludesResourcesType">
    <xs:sequence>
      <xs:element ref="Style" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Includes.Resources" type="IncludesResourcesType">
    <xs:annotation>
      <xs:documentation>
        Normal Style entries merged into the receiving owner's Resources
        property. Declare Presets as direct children of Includes.
      </xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Presets -->

  <xs:complexType name="PresetsType">
    <xs:annotation>
      <xs:documentation>
        Name is required when this element defines inline or standalone Preset
        children. A source-only loader may omit Name because the referenced
        Presets document supplies it.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="Preset" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="Name" type="xs:string" />
    <xs:attribute name="Selected" type="xs:string" />
    <xs:attribute name="Default" type="xs:string" />
    <xs:attribute name="Source" type="xs:string">
      <xs:annotation><xs:documentation>File path, resource name, or embedded:// resource URI.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="SourceKind" type="SourceKindLiteral" />
    <xs:attribute name="Assembly" type="xs:string" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:complexType name="PresetType">
    <xs:sequence>
      <xs:element ref="Set" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:complexType name="SetType">
    <xs:annotation>
      <xs:documentation>
        A preset value. The required Value attribute may contain a literal,
        binding, function, or preset expression. Preset bindings are OneWay.
        Notifying binding paths refresh every active preset consumer. Set is
        empty: inner text and child elements are not part of the grammar.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="Key" type="xs:string" use="required" />
    <xs:attribute name="Value" type="xs:string" use="required" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:element name="Presets" type="PresetsType" />
  <xs:element name="Preset" type="PresetType" />
  <xs:element name="Set" type="SetType" />

  <!-- XML component documents -->

  <xs:complexType name="ComponentType">
    <xs:annotation>
      <xs:documentation>
        XML component root. Runtime grammar accepts an optional
        Component.Properties block, component-level Presets and
        Component.Resources metadata, and exactly one visual root. Class
        optionally names a concrete public CLR code-behind type with a public
        parameterless constructor; a new instance is created for every
        component invocation. Omit Class for an XML-only component. XSD 1.0
        uses a lax sequence here so the visual root can be an
        application-registered control without a generated schema.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:any minOccurs="1" maxOccurs="unbounded" processContents="lax" />
    </xs:sequence>
    <xs:attribute name="Class" type="StaticTypeName">
      <xs:annotation>
        <xs:documentation>
          Static full CLR name of the optional per-invocation component
          code-behind. The type must be concrete, closed, public, and expose a
          public parameterless constructor. Component use remains the short
          registered resource name, for example ToastNotification.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:complexType name="ComponentPropertiesType">
    <xs:sequence>
      <xs:element ref="Property" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ComponentPropertyType">
    <xs:annotation>
      <xs:documentation>
        A typed component-local observable value. An inner Mode=TwoWay binding
        can edit it; an invocation Mode=TwoWay binding can forward that edit to
        a writable INotifyPropertyChanged property or PropertyBinding value.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="Name" type="xs:NCName" use="required" />
    <xs:attribute name="Type" type="StaticTypeName">
      <xs:annotation><xs:documentation>A static CLR type name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="Default" type="xs:string">
      <xs:annotation><xs:documentation>A static literal converted to Type. Binding, Function, and Preset expressions are not allowed in component defaults.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="Required" type="BooleanLiteral" />
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:complexType name="ChildrenSlotType">
    <xs:annotation>
      <xs:documentation>
        The optional single caller-content slot in an embedded XML component
        template. Keep this element empty. A component invocation may supply
        zero or more visual Controls. Each child retains the caller Form/item
        data context, namescope, event target, and binding ownership while the
        surrounding template uses the component property/code-behind context.
        Children cannot be the component visual root or appear inside a property
        element or item template.
      </xs:documentation>
    </xs:annotation>
  </xs:complexType>

  <xs:element name="Component" type="ComponentType">
    <xs:annotation><xs:documentation>Root of an embedded, reusable XML component document.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="Component.Properties" type="ComponentPropertiesType" />
  <xs:element name="Component.Resources" type="ResourcesType">
    <xs:annotation>
      <xs:documentation>
        Styles and presets promoted into the component's single visual root.
        Includes.Resources placed directly under Component normalizes to this
        property during include composition.
      </xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Property" type="ComponentPropertyType" />
  <xs:element name="Children" type="ChildrenSlotType" />

