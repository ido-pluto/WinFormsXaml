  <xs:element name="UserControl.Resources" type="ResourcesType" />
  <xs:element name="FlowLayoutPanel.Resources" type="ResourcesType" />
  <xs:element name="TableLayoutPanel.Resources" type="ResourcesType" />
  <xs:element name="GroupBox.Resources" type="ResourcesType" />
  <xs:element name="SplitContainer.Resources" type="ResourcesType" />
