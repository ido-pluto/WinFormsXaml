      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
    </xs:sequence>
    <xs:attributeGroup ref="ControlAttributes" />
    <xs:attributeGroup ref="StyleSelectionAttributes" />
    <xs:attribute name="AutoSizeMode" type="ButtonAutoSizeModeValue" />
    <xs:attribute name="Class" type="StaticTypeName">
      <xs:annotation><xs:documentation>Document-root metadata: the exact, static full CLR code-behind type. Direct embedded-runtime loading can create a concrete type with a public parameterless constructor; XmlForm verifies a supplied instance. Class cannot contain a markup expression.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <!-- WinFormsXaml layout and data elements -->

  <xs:element name="Grid" type="ControlType">
    <xs:annotation><xs:documentation>Row and column layout with fixed, Auto, and proportional * definitions.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="StackPanel" type="ControlType">
    <xs:annotation><xs:documentation>Places children in vertical or horizontal order.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="DockPanel" type="ControlType">
    <xs:annotation><xs:documentation>Docks children to edges and optionally fills the remainder with the final child.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="Canvas" type="ControlType">
    <xs:annotation><xs:documentation>Coordinate layout using Canvas.Left, Canvas.Top, Canvas.Right, and Canvas.Bottom attached properties.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="FlexPanel" type="FlexPanelType">
    <xs:annotation><xs:documentation>Row or column flex layout with literal or dynamic direction, line alignment, wrapping, gap, and child FlexGrow values.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="Border" type="ControlType">
    <xs:annotation><xs:documentation>Single-child host with BorderBrush and BorderThickness.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="ScrollViewer" type="ControlType">
    <xs:annotation><xs:documentation>Single-child scrollable host.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="Viewbox" type="ControlType">
    <xs:annotation><xs:documentation>Single-child layout host.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="ItemsControl" type="ItemsControlType">
    <xs:annotation><xs:documentation>Repeats one ItemTemplate over ItemsSource with incremental refresh, notifying item-property patches, optional non-virtual row/column wrapping, optional one-dimensional viewport virtualization, and an optional framework-owned scrollbar on the active Orientation axis. Wrap and Virtualizing cannot both be true.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="TabView" type="TabViewType">
    <xs:annotation><xs:documentation>Framework-owned tabs with completely styleable headers and content chrome. Use direct TabViewItem children or one TabView.TabItems property element. Direction follows FlowDirection and inherited RightToLeft.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="TabViewItem" type="TabViewItemType">
    <xs:annotation><xs:documentation>One TabView page. Header sets the header text. The item accepts at most one direct visual content child at runtime; local resources do not count as content.</xs:documentation></xs:annotation>
  </xs:element>

