  <xs:simpleType name="StaticIncludeReference">
    <xs:annotation>
      <xs:documentation>
        Non-empty static include composition metadata. Binding, Function, and
        Preset expressions are not evaluated while the document tree is being
        composed.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^{}]*[^\s{}][^{}]*" />
    </xs:restriction>
  </xs:simpleType>

