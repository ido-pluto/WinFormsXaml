        HorizontalScrollStyle are nullable ScrollBarStyle object properties.
        Omit them, or supply an expression that resolves to null, to retain the
        native scrollbar. A non-null style selects the framework-owned scrollbar
        for the matching Orientation axis. The inactive-axis value is retained
        but is not instantiated or displayed. Wrap enables retained non-virtual
        row or column flow; Spacing is its item and line gap. Wrap cannot be
        combined with Virtualizing.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="true">
      <xs:extension base="ControlType">
        <xs:attributeGroup ref="FlexLineAttributes" />
        <xs:attribute name="VerticalScrollStyle" type="OptionalScrollBarStyleValue">
          <xs:annotation><xs:documentation>Binding, Function, or Preset expression that resolves to a ScrollBarStyle for Orientation=Vertical. Omitted, empty, false, null, or unresolved retains the native scrollbar.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="HorizontalScrollStyle" type="OptionalScrollBarStyleValue">
          <xs:annotation><xs:documentation>Binding, Function, or Preset expression that resolves to a ScrollBarStyle for Orientation=Horizontal. Omitted, empty, false, null, or unresolved retains the native scrollbar.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ScrollBarGap" type="NonNegativeIntegerValue" default="0">
          <xs:annotation><xs:documentation>Empty pixels between item content and the active native or framework-owned scrollbar. The gap follows vertical RTL placement and also works for horizontal scrolling. Literal integers and Binding, Function, or Preset expressions are accepted.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

