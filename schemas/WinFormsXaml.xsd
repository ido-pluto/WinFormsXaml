<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">
  <xs:annotation>
    <xs:documentation>
      WinFormsXaml editor schema. This XSD 1.0 schema supplies completion and
      hover documentation for the canonical built-in markup vocabulary,
      including Form/Class documents, native controls, layout, binding
      expressions, presets, reusable Includes documents, item templates and
      tuning, registered Component documents, declared properties, and
      Children projection. The runtime can
      also discover arbitrary public WinForms types, registered controls, CLR
      properties, and events. Lax element and attribute wildcards intentionally
      keep that reflection-based extension model available. At runtime, XML
      parser failures retain their parser line and position. Semantic property
      failures report markup source, element path, property name, and the
      original failing attribute position when retained, otherwise the deepest
      opening element position. Item-template clones and registered-component
      TemplateXml round trips preserve those source coordinates.
    </xs:documentation>
  </xs:annotation>

  <!-- Value shapes -->

  <xs:simpleType name="DynamicExpression">
    <xs:annotation>
      <xs:documentation>
        A Binding, Function, or Preset expression. Binding forms include
        {Binding}, {Binding Title}, {Binding Path=Title}, {Binding !IsReady},
        and safe computed one-way forms such as {Binding Count &gt; 10},
        {Binding Count &lt;= 2}, and {Binding IsReady &amp;&amp; !IsBusy}. Computed
        operands are paths, parentheses, quoted strings, finite numbers,
        booleans, or null. Operators are !, &lt;/&lt;=/&gt;/&gt;=,
        ==/===/!=/!==, &amp;&amp;, and ||, in that precedence order from highest to
        lowest after primary expressions. In XML attributes, escape &lt; as
        &amp;lt; and &amp;&amp; as &amp;amp;&amp;amp;. Comparisons do not coerce strings or
        unrelated types; numeric CLR types compare numerically. Every operand
        path is resolved and observed eagerly. Computed bindings do not allow
        Mode=TwoWay, methods, indexers, arithmetic, assignment, or ternary
        expressions; limits are 1024 expression characters, 256 tokens, and
        32 nested parenthesis levels. Ordinary bindings support the optional
        Mode=OneWay|TwoWay,
        Source=Current|CodeBehind, and TwoWay-only
        UpdateSourceTrigger=PropertyChanged|LostFocus|Explicit settings.
        TwoWay requires one complete,
        non-negated Binding ending in a writable PropertyBinding value or a
        writable notification-based CLR property. Function forms include
        {Function Name}, {Function Name(.)}, and explicit arguments such as
        DataContext, this, CodeBehind, null, booleans, numbers, quoted strings,
        and notifying paths. A bare Function first seeks zero arguments and then
        the current data context. Presets use {Preset SetName.Key}. These forms
        may also be interpolated into text. StaticResource is separate: it is
        accepted only for named style selection and Style.BasedOn.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*\{(Binding(\s+\S[^{}]*)?|Function\s+\S[^{}]*|Preset\s+\S[^{}]*)\}\s*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InactiveScrollBarStyleLiteral">
    <xs:restriction base="xs:string">
      <xs:enumeration value="" />
      <xs:enumeration value="false" />
      <xs:enumeration value="False" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OptionalScrollBarStyleValue">
    <xs:union memberTypes="InactiveScrollBarStyleLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="StaticTypeName">
    <xs:annotation>
      <xs:documentation>
        A non-empty CLR type name used as static identity metadata. Markup
        expressions are not valid in this position.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="[^{}]+" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BooleanLiteral">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true" />
      <xs:enumeration value="false" />
      <xs:enumeration value="True" />
      <xs:enumeration value="False" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BooleanValue">
    <xs:annotation>
      <xs:documentation>
        A boolean literal or a runtime expression string. This includes
        TwoWay bindings such as {Binding Accepted, Mode=TwoWay} on
        CheckBox.Checked and CheckBox.IsChecked, plus one-way comparison and
        logical bindings such as {Binding Count &gt; 10} and
        {Binding Count &lt; 20 &amp;&amp; IsReady}.
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="BooleanLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="IntegerValue">
    <xs:union memberTypes="xs:int DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="FloatingNumberLiteral">
    <xs:restriction base="xs:token">
      <xs:pattern value="[+-]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NumberValue">
    <xs:union memberTypes="xs:decimal DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="FloatingNumberValue">
    <xs:union memberTypes="FloatingNumberLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="NonNegativeIntegerLiteral">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeIntegerValue">
    <xs:union memberTypes="NonNegativeIntegerLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="AtLeastMinusOneIntegerLiteral">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="-1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AtLeastMinusOneIntegerValue">
    <xs:union memberTypes="AtLeastMinusOneIntegerLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="PositiveIntegerLiteral">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveIntegerValue">
    <xs:union memberTypes="PositiveIntegerLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="ColorValue">
    <xs:annotation>
      <xs:documentation>
        A System.Drawing.Color literal, including hex, named, Color.Red,
        Color.Transparent, SystemColors.Control, and other public Color or
        SystemColors values; or a Binding, Function, or Preset expression whose
        result converts to Color.
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:string DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="PaddingValue">
    <xs:annotation>
      <xs:documentation>
        A System.Windows.Forms.Padding literal with one, two, or four integer
        components, or a Binding, Function, or Preset expression whose result
        converts to Padding. Four components are physical left, top, right,
        and bottom values and are not mirrored in right-to-left layouts.
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:string DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="AutoLiteral">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Auto" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PixelUnitLiteral">
    <xs:annotation>
      <xs:documentation>A fractional numeric token carrying a px or pt suffix. PixelValue also accepts unsuffixed decimals.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="[+-]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?(px|pt)" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PixelValue">
    <xs:union memberTypes="FloatingNumberLiteral PixelUnitLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="AutoPixelValue">
    <xs:union memberTypes="AutoLiteral FloatingNumberLiteral PixelUnitLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="NonNegativeDecimalLiteral">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeNumberValue">
    <xs:union memberTypes="NonNegativeDecimalLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="NonNegativePixelUnitLiteral">
    <xs:restriction base="xs:token">
      <xs:pattern value="[+]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?(px|pt)" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StarGridLengthLiteral">
    <xs:restriction base="xs:token">
      <xs:pattern value="([+]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?(px|pt)?)?[*]" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GridLengthValue">
    <xs:annotation>
      <xs:documentation>
        A non-negative fixed size, Auto, or proportional star size such as *,
        2*, or 0.5*. Grid definitions are static layout metadata and do not bind.
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="AutoLiteral NonNegativeDecimalLiteral NonNegativePixelUnitLiteral StarGridLengthLiteral" />
  </xs:simpleType>

  <xs:simpleType name="StaticResourceExpression">
    <xs:annotation>
      <xs:documentation>
        A named style reference in the canonical form
        {StaticResource StyleKey}. It is valid for style selection and BasedOn,
        not as a general property-value expression.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\{StaticResource .+\}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OrientationLiteral">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Horizontal" />
      <xs:enumeration value="Vertical" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OrientationValue">
    <xs:union memberTypes="OrientationLiteral DynamicExpression" />
  </xs:simpleType>

  <xs:simpleType name="ItemsControlVirtualizationModeLiteral">
