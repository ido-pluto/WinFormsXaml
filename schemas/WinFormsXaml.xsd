    <!-- ItemsControl source, diffing, progressive rendering, and virtualization. -->
    <xs:attribute name="ItemsSource" type="DynamicExpression">
      <xs:annotation><xs:documentation>An expression returning IEnumerable, usually {Binding Items}. ItemsBinding and IBindingList collection changes are observed, and a notifying owner can replace the complete source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="Spacing" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Non-negative ItemsControl spacing. On a one-dimensional host it separates adjacent realized entries; with Wrap=true it is both the item gap and wrapped-line gap. Integer literals and Binding, Function, or Preset expressions are accepted.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ItemKeyPath" type="xs:string">
      <xs:annotation><xs:documentation>Optional field/property path used as stable item identity for keyed reuse and moves. Id, ID, _id, or Key is auto-detected when omitted; index is the final fallback.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ItemVersionPath" type="xs:string">
      <xs:annotation><xs:documentation>Optional cheap application version/token path. An equal explicit token can skip ordinary binding evaluation for that item.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ReuseItems" type="BooleanValue">
      <xs:annotation><xs:documentation>Reuses unchanged keyed control trees instead of rebuilding them.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ReevaluateFunctionsOnRefresh" type="BooleanValue">
      <xs:annotation><xs:documentation>Re-invokes Function expressions during explicit refresh so untracked external function state can participate in the diff.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ProgressiveRendering" type="BooleanValue">
      <xs:annotation><xs:documentation>Builds changed and new entries in UI-message-loop batches while retaining the committed view until the refresh can publish.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ProgressiveBatchSize" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Maximum entry count attempted by one progressive tick. Runtime values below one normalize to one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ProgressiveInterval" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Requested milliseconds between progressive UI ticks. Runtime values below one normalize to one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ProgressiveTimeBudgetMs" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Maximum UI-thread work budget per progressive tick before yielding. Runtime values below one normalize to one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="LiveScroll" type="BooleanValue">
      <xs:annotation><xs:documentation>Updates content while the native scrollbar thumb is dragged even when the operating-system preference disables live contents.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="SmoothScroll" type="BooleanValue" default="false">
      <xs:annotation><xs:documentation>ItemsControl only. False by default, using native-style live-control movement. When true, wheel and line/page commands use one coalesced UI-thread animation; repeated input retargets the active transition instead of queuing another one. Scrollbar thumb tracking and thumb release remain immediate and cancel any active transition. Boolean literals and Binding, Function, or Preset expressions are accepted.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="SmoothScrollDuration" type="PositiveIntegerValue" default="120">
      <xs:annotation><xs:documentation>ItemsControl only. Positive duration in milliseconds of one coalesced smooth-scroll transition; the default is 120. Positive integer literals and Binding, Function, or Preset expressions are accepted.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="KeepScrollBarOnRight" type="BooleanValue">
      <xs:annotation><xs:documentation>Keeps the scrolling host left-to-right so its vertical scrollbar remains on the right while repeated children can retain RTL content.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="Virtualizing" type="BooleanValue" default="false">
      <xs:annotation><xs:documentation>Explicitly enables viewport virtualization; the runtime default is false, so omitted markup always uses the ordinary renderer. Controls activates its direct synchronous backend once the logical count reaches VirtualizationThreshold and realizes only the visible range plus OverscanItems. Lightweight requires true and paints its visible fixed-size rows without native row controls.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="VirtualizationMode" type="ItemsControlVirtualizationModeValue">
      <xs:annotation><xs:documentation>Selects the row backend after virtualization is explicitly enabled. Controls is the backend default and realizes complete WinForms control trees. Lightweight explicitly selects one owner-drawn surface with no native child tree per row. Its first strict profile requires Virtualizing=true, AutoScroll=true, Orientation=Vertical, a positive FixedItemSize, and an ItemTemplate composed only from one Border/StackPanel plus Label, two-way CheckBox, HyperlinkLabel, and Image leaves. Lightweight Image.Source must be one complete dynamic expression returning Image, Icon, or encoded byte[]; interpolation, URI, and animated image lifecycle require Controls. Ineligible lightweight markup is a location-aware load error and never silently falls back to Controls.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ItemRecycling" type="ItemRecyclingModeValue">
      <xs:annotation><xs:documentation>Controls cross-item reuse of detached native row trees. Disabled is the safe default and keeps same-item identity/key cache reuse only. Explicit applies only to VirtualizationMode=Controls and considers a different item only when the ItemTemplate root implements IRecyclableItemControl and accepts the immutable ItemRecycleContext. The callback runs detached with item subscriptions inactive. A false result disposes the candidate and constructs a fresh tree; an exception fails the refresh visibly. Arbitrary roots are never inferred to be recyclable.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="VirtualizationThreshold" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Minimum item count at which an enabled Controls backend switches to direct viewport virtualization. Below this count, the ordinary renderer remains active and each root keeps its desired or explicit main-axis size; configured FixedItemSize and EstimatedItemSize do not replace that geometry. Runtime values below one normalize to one. Lightweight is explicitly selected and ignores this threshold.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="OverscanItems" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Defines a fixed maximum budget of two times this many extra logical items. Initial viewports split it before and after the visible range, and scrolling biases the same total budget ahead of travel. Controls retains its published bias for duplicate callbacks at the settled offset so an identical committed range remains unchanged. A stationary Lightweight viewport returns to the symmetric split. Controls realizes native trees, while Lightweight retains evaluated row-value snapshots without row controls. Runtime values below zero normalize to zero.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="EstimatedItemSize" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Initial main-axis estimate used by active direct Controls virtualization before a variable-size item is measured: height for a vertical list and width for a horizontal list. It does not size ordinary nonvirtual rows and is not the Lightweight row size. Runtime values below one normalize to one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="VirtualizationCacheItems" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Maximum detached Controls-backend trees retained as bounded reuse hints. Reuse is same-item identity/key only by default; ItemRecycling=Explicit can opt participating roots into cross-item reset. Cached trees are never authoritative logical state; zero disables this cache. Lightweight has no detached tree cache and ignores this value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="FixedItemSize" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>Exact main-axis item content size used by active direct virtualization: height for a vertical list and width for a horizontal Controls list. In active direct Controls virtualization, zero keeps estimated variable-size measurement and a positive value selects the uniform path. Lightweight requires a positive vertical row height. The ordinary renderer, including a Controls profile below VirtualizationThreshold, intentionally ignores this setting for geometry and honors each root's desired size or explicit Height/Width.</xs:documentation></xs:annotation>
    </xs:attribute>

    <!-- ProgressBar. -->
    <xs:attribute name="MarqueeAnimationSpeed" type="NonNegativeIntegerValue">
      <xs:annotation><xs:documentation>The requested marquee frame interval in milliseconds. When native marquee support is unavailable, the native Blocks grow/drain fallback uses the same logical value.</xs:documentation></xs:annotation>
    </xs:attribute>
