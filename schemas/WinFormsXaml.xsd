  <xs:attributeGroup name="FlexLineAttributes">
    <xs:attribute name="JustifyContent" type="FlexJustifyValue">
      <xs:annotation><xs:documentation>FlexPanel or ItemsControl only. Places unused main-axis space within each line using Start, Center, End, SpaceBetween, or SpaceAround. On ItemsControl it applies to each wrapped row or column. A Binding, Function, or Preset expression may supply the value.</xs:documentation></xs:annotation>
