<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net20</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WinFormsXaml.InteractiveBenchmarks</AssemblyName>
    <RootNamespace>WinFormsXaml.InteractiveBenchmarks</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>2</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppConfig>../benchmarks/WinFormsXaml.InteractiveBenchmarks/App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/BenchmarkDashboard.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/BenchmarkScenario.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/BenchmarkScrollWorkload.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/DeterministicBenchmarkImage.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/PerformanceStatistics.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Program.cs" />
    <Compile Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Properties/AssemblyInfo.cs" />
    <EmbeddedResource Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Fixtures/InteractiveBenchmarkForm.xml"
                      LogicalName="WinFormsXaml.InteractiveBenchmarks.Fixtures.InteractiveBenchmarkForm.xml" />
    <EmbeddedResource Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Fixtures/InteractiveLightweightForm.xml"
                      LogicalName="WinFormsXaml.InteractiveBenchmarks.Fixtures.InteractiveLightweightForm.xml" />
    <EmbeddedResource Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Fixtures/InteractiveRecyclingForm.xml"
                      LogicalName="WinFormsXaml.InteractiveBenchmarks.Fixtures.InteractiveRecyclingForm.xml" />
    <EmbeddedResource Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/Fixtures/InteractiveNonVirtualForm.xml"
                      LogicalName="WinFormsXaml.InteractiveBenchmarks.Fixtures.InteractiveNonVirtualForm.xml" />
    <None Include="../benchmarks/WinFormsXaml.InteractiveBenchmarks/App.config" Link="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="WinFormsXaml.Validation.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net20" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
