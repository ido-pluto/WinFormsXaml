<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net20</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WinFormsXaml.LayoutTests</AssemblyName>
    <RootNamespace>WinFormsXaml.LayoutTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>2</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppConfig>../tests/WinFormsXaml.LayoutTests/App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../tests/WinFormsXaml.LayoutTests/FlexPanelLayoutTests.cs" />
    <Compile Include="../tests/WinFormsXaml.LayoutTests/PreferredSizePassCacheTests.cs" />
    <Compile Include="../tests/WinFormsXaml.LayoutTests/TabViewLayoutTests.cs" />
    <Compile Include="../tests/WinFormsXaml.LayoutTests/Program.cs" />
    <Compile Include="../tests/WinFormsXaml.LayoutTests/Properties/AssemblyInfo.cs" />
    <None Include="../tests/WinFormsXaml.LayoutTests/App.config" Link="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="WinFormsXaml.Validation.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net20" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
