<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net20</TargetFramework>
    <AssemblyName>WinFormsXaml</AssemblyName>
    <RootNamespace>WinFormsXaml</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>2</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/WinFormsXaml/**/*.cs"
             Exclude="../src/WinFormsXaml/bin/**/*.cs;../src/WinFormsXaml/obj/**/*.cs;../src/WinFormsXaml/Properties/AssemblyInfo.cs" />
    <Compile Include="$(PackageAssemblyInfo)"
             Condition=" '$(PackageAssemblyInfo)' != '' " />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net20"
                      Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidatePackageBuildInputs" BeforeTargets="CoreCompile">
    <Error Condition=" '$(PackageAssemblyInfo)' == '' "
           Text="PackageAssemblyInfo must identify the generated package assembly metadata file." />
    <Error Condition=" !Exists('$(PackageAssemblyInfo)') "
           Text="PackageAssemblyInfo does not exist: $(PackageAssemblyInfo)" />
  </Target>
</Project>
