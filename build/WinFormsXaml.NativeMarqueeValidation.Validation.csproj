<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net20</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WinFormsXaml.NativeMarqueeValidation</AssemblyName>
    <RootNamespace>WinFormsXaml.NativeMarqueeValidation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>2</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppConfig>../tests/WinFormsXaml.NativeMarqueeValidation/App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../tests/WinFormsXaml.NativeMarqueeValidation/Program.cs" />
    <Compile Include="../tests/WinFormsXaml.NativeMarqueeValidation/Properties/AssemblyInfo.cs" />
    <None Include="../tests/WinFormsXaml.NativeMarqueeValidation/App.config"
          Link="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="WinFormsXaml.Validation.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net20"
                      Version="1.0.3"
                      PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
