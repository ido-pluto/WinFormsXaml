<?xml version="1.0" encoding="utf-8" ?>
<Form Name="InteractiveLightweightForm"
      Text="WinFormsXaml interactive Lightweight virtualization"
      Width="780"
      Height="560"
      StartPosition="CenterParent"
      ShowInTaskbar="false">
  <Grid Dock="Fill" Padding="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0"
           Text="10,000 owner-drawn rows; mixed small and large scroll changes"
           AutoSize="true"
           Margin="0,0,0,8" />

    <ItemsControl Name="BenchmarkRows"
                  Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoScroll="true"
                  Virtualizing="true"
                  VirtualizationMode="Lightweight"
                  FixedItemSize="72"
                  OverscanItems="3"
                  Spacing="4">
      <ItemsControl.ItemTemplate>
        <Border Padding="8,5"
                BorderBrush="#D4D4D8"
                BorderThickness="1"
                Background="#FAFAFA">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Width="82"
                      Text="#{Binding Id}"
                      Checked="{Binding Selected, Mode=TwoWay}" />
            <Label Width="205"
                   Text="{Binding Title}"
                   FontWeight="Bold"
                   AutoEllipsis="true" />
            <Label Width="330"
                   Text="{Binding Detail}"
                   Foreground="#52525B"
                   AutoEllipsis="true" />
            <HyperlinkLabel Width="58"
                            Text="Open"
                            NavigateUri="{Binding Url}" />
          </StackPanel>
        </Border>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Form>
