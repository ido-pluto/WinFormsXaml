<Component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           Class="ComponentsGallery.UI.Components.GalleryCard"
           xsi:noNamespaceSchemaLocation="../../../../schemas/WinFormsXaml.xsd">
  <Component.Properties>
    <Property Name="Title" Type="String" />
    <Property Name="AccentColor"
              Type="System.Drawing.Color"
              Default="SteelBlue" />
    <Property Name="OuterMargin"
              Type="System.Windows.Forms.Padding"
              Default="0" />
  </Component.Properties>

  <Border BorderBrush="{Binding AccentColor}"
          BorderThickness="2"
          Padding="12"
          Margin="{Binding OuterMargin}">
    <StackPanel>
      <Label Text="{Binding Title}"
             ForeColor="{Binding AccentColor}"
             FontWeight="Bold"
             AutoSize="true"
             Margin="0,0,0,8" />
      <Button Text="Update from component code-behind"
              Click="UpdateFromComponent_Click"
              Margin="0,0,0,8" />
      <Children />
    </StackPanel>
  </Border>
</Component>
